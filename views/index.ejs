<% const bp = blogPath && blogPath !== '' ? blogPath + '/' : '/'; %>
<section class="hero">
    <h1>Recent Posts</h1>
    <% if (tags.length > 0 || pinnedSlugs.length > 0) { %>
    <nav class="tags-nav">
        <span class="tags-label">Tags:</span>
        <% tags.forEach(tag => { %>
        <a href="<%= bp %>tag/<%= tag %>" class="tag">#<%= tag %></a>
        <% }); %>
        <% if (pinnedSlugs.length > 0) { %>
        <a href="<%= bp %>tag/pinned" class="tag pinned-nav">#pinned</a>
        <% } %>
    </nav>
    <% } %>
</section>

<% if (posts.length === 0) { %>
    <div class="empty-state">
        <p>No posts yet.</p>
        <p>Create HTML files in the <code>content/posts/</code> folder to add posts.</p>
    </div>
<% } else { %>
    <div class="posts-list">
        <% posts.forEach(post => { %>
        <article class="post-card" id="post-<%= post.id %>">
            <h2 class="post-title">
                <a href="<%= bp %><%= post.slug %>"><%= post.title %></a><span class="post-id">#<%= post.id %></span>
            </h2>
            <time class="post-date" datetime="<%= post.published_at %>">
                <%= new Date(post.published_at).toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                }) %>
            </time>
            <p class="post-excerpt"><%= post.excerpt %></p>
            <div class="post-tags">
                <% if (pinnedSlugs.includes(post.slug)) { %>
                <a href="<%= bp %>tag/pinned" class="tag pinned">#pinned</a>
                <% } %>
                <% post.tags.forEach(tag => { %>
                <a href="<%= bp %>tag/<%= tag %>" class="tag">#<%= tag %></a>
                <% }); %>
            </div>
            <div class="post-stats">
                <span class="stat">❤️ <%= post.likes_count %></span>
                <span class="stat">💬 <%= post.comments_count %></span>
                <span class="stat">🔄 <%= post.shares_count %></span>
            </div>
        </article>
        <% }); %>
    </div>
    
    <% if (pagination && (pagination.hasPrev || pagination.hasNext)) { %>
    <nav class="pagination">
        <% if (pagination.hasPrev) { %>
        <a href="<%= bp %>?page=<%= pagination.current - 1 %>" class="pagination-link pagination-prev">← Newer</a>
        <% } else { %>
        <span class="pagination-link pagination-disabled">← Newer</span>
        <% } %>
        <span class="pagination-info">Page <%= pagination.current %> of <%= pagination.total %></span>
        <% if (pagination.hasNext) { %>
        <a href="<%= bp %>?page=<%= pagination.current + 1 %>" class="pagination-link pagination-next">Older →</a>
        <% } else { %>
        <span class="pagination-link pagination-disabled">Older →</span>
        <% } %>
    </nav>
    <% } %>
<% } %>
