<!DOCTYPE html>
<%
    const isLargePreview = preview === 'large';
    const bodyFontSize = isLargePreview ? '16px' : '14px';
    const titleFontSize = isLargePreview ? '1.2rem' : '1rem';
    const metaFontSize = isLargePreview ? '0.875rem' : '0.75rem';
    const excerptFontSize = isLargePreview ? '1rem' : '0.875rem';
    const statsFontSize = isLargePreview ? '0.875rem' : '0.75rem';
    const tagFontSize = isLargePreview ? '0.875rem' : '0.75rem';
    const containerWidth = isLargePreview ? '760px' : '600px';
    const cardPadding = isLargePreview ? '18px 0' : '12px 0';
%>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: transparent;
            font-size: <%= bodyFontSize %>;
            line-height: 1.5;
            color: #1a1a1a;
        }
        .embed-container {
            max-width: <%= containerWidth %>;
            margin: 0 auto;
        }
        .post-card {
            padding: <%= cardPadding %>;
            border-bottom: 1px solid #e5e5e5;
        }
        .post-card:last-child {
            border-bottom: none;
        }
        .post-title {
            font-size: <%= titleFontSize %>;
            font-weight: 600;
            margin-bottom: 4px;
        }
        .post-title a {
            color: #1a1a1a;
            text-decoration: none;
        }
        .post-title a:hover {
            color: #5a9fd4;
        }
        .post-meta {
            font-size: <%= metaFontSize %>;
            color: #666;
            margin-bottom: 4px;
        }
        .post-excerpt {
            font-size: <%= excerptFontSize %>;
            color: #413d3d;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: <%= excerptLines %>;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .post-stats {
            font-size: <%= statsFontSize %>;
            color: #888;
        }
        .post-stats span {
            margin-right: 12px;
        }
        .post-tags {
            margin-top: 6px;
        }
        .tag {
            display: inline-block;
            font-size: <%= tagFontSize %>;
            padding: 2px 8px;
            border-radius: 3px;
            margin-right: 4px;
            text-decoration: none;
        }
        .tag.pinned {
            background: #e67e22;
            color: #fff;
        }
        .tag:not(.pinned) {
            background: #f0f0f0;
            color: #666;
        }
        @media (prefers-color-scheme: dark) {
            body { background: transparent; color: #e5e5e5; }
            .post-title a { color: #454545; }
            .post-title a:hover { color: #7ca428; }
            .post-meta { color: #999; }
            .post-excerpt { color: #413d3d; }
            .post-stats { color: #888; }
            .post-card { border-color: #333; }
            .tag.pinned { background: #d35400; }
            .tag:not(.pinned) { background: #333; color: #aaa; }
        }
    </style>
</head>
<body>
<% const bp = blogPath && blogPath !== '' ? blogPath + '/' : '/'; %>
    <div class="embed-container">
        <% posts.forEach(post => { %>
        <article class="post-card">
            <h2 class="post-title">
                <a href="<%= bp %><%= post.slug %>" target="_top"><%= post.title %></a>
            </h2>
            <div class="post-meta">
                <time datetime="<%= post.published_at %>">
                    <%= new Date(post.published_at).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    }) %>
                </time>
            </div>
            <% if (post.excerpt) { %>
            <p class="post-excerpt"><%= post.excerpt %></p>
            <% } %>
            <div class="post-tags">
                <% if (pinnedSlugs.includes(post.slug)) { %>
                <a href="<%= bp %>tag/pinned" class="tag pinned">#pinned</a>
                <% } %>
                <% post.tags.forEach(tag => { %>
                <a href="<%= bp %>tag/<%= tag %>" class="tag">#<%= tag %></a>
                <% }); %>
            </div>
            <div class="post-stats">
                <span>❤️ <%= post.likes_count || 0 %></span>
                <span>💬 <%= post.comments_count || 0 %></span>
                <span>🔄 <%= post.shares_count || 0 %></span>
            </div>
        </article>
        <% }); %>
    </div>
</body>
</html>
