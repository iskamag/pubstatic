<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: transparent;
            font-size: 14px;
            line-height: 1.5;
            color: #1a1a1a;
        }
        .embed-container {
            max-width: 600px;
            margin: 0 auto;
        }
        .post-card {
            padding: 12px 0;
            border-bottom: 1px solid #e5e5e5;
        }
        .post-card:last-child {
            border-bottom: none;
        }
        .post-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 4px;
        }
        .post-title a {
            color: #1a1a1a;
            text-decoration: none;
        }
        .post-title a:hover {
            color: #5a9fd4;
        }
        .post-meta {
            font-size: 0.75rem;
            color: #666;
            margin-bottom: 4px;
        }
        .post-excerpt {
            font-size: 0.875rem;
            color: #444;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .post-stats {
            font-size: 0.75rem;
            color: #888;
        }
        .post-stats span {
            margin-right: 12px;
        }
        @media (prefers-color-scheme: dark) {
            body { background: transparent; color: #e5e5e5; }
            .post-title a { color: #e5e5e5; }
            .post-title a:hover { color: #7ca428; }
            .post-meta { color: #999; }
            .post-excerpt { color: #bbb; }
            .post-stats { color: #888; }
            .post-card { border-color: #333; }
        }
    </style>
</head>
<body>
<% const bp = typeof blogPath !== 'undefined' ? blogPath + '/' : '/'; %>
    <div class="embed-container">
        <% posts.forEach(post => { %>
        <article class="post-card">
            <h2 class="post-title">
                <a href="<%= bp %>p/<%= post.slug %>"><%= post.title %></a>
            </h2>
            <div class="post-meta">
                <time datetime="<%= post.published_at %>">
                    <%= new Date(post.published_at).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: 'numeric' 
                    }) %>
                </time>
            </div>
            <% if (post.excerpt) { %>
            <p class="post-excerpt"><%= post.excerpt %></p>
            <% } %>
            <div class="post-stats">
                <span>❤️ <%= post.likes_count || 0 %></span>
                <span>💬 <%= post.comments_count || 0 %></span>
                <span>🔄 <%= post.shares_count || 0 %></span>
            </div>
        </article>
        <% }); %>
    </div>
</body>
</html>